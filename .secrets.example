# Example secrets file for act local testing
# Copy to .secrets and fill in actual values
# DO NOT commit .secrets to version control

# NPM token for publishing (production only)
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub token for releases
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom registry URLs
NPM_REGISTRY=https://registry.npmjs.org
GITHUB_REGISTRY=https://npm.pkg.github.com